[Unit]
Description=CaddyForge custom Caddy
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
User=caddyforge
Group=caddyforge
Environment=HOME=/var/lib/caddyforge
Environment=XDG_DATA_HOME=/var/lib/caddyforge
Environment=XDG_CONFIG_HOME=/var/lib/caddyforge
EnvironmentFile=/etc/caddyforge/caddy.env
WorkingDirectory=/etc/caddyforge
ExecStartPre=/opt/caddyforge/current/caddy validate --config /etc/caddyforge/Caddyfile --adapter caddyfile
ExecStart=/opt/caddyforge/current/caddy run --config /etc/caddyforge/Caddyfile --adapter caddyfile
ExecReload=/opt/caddyforge/current/caddy reload --config /etc/caddyforge/Caddyfile --adapter caddyfile --force
TimeoutStartSec=120
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddyforge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
